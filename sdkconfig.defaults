# 目標晶片：ESP32-S3 N16R8（16MB Flash、8MB Octal PSRAM）
# ESP-IDF 5.5.3

# ── CPU 頻率：最高 240MHz ─────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Flash：16MB、QIO 模式、80MHz ─────────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── PSRAM：8MB Octal 模式、80MHz ─────────────────────
# 啟用 PSRAM，並讓 malloc() 可直接分配 PSRAM
# .bss 靜態變數允許放入外部記憶體以節省內部 SRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ── FreeRTOS：Tick Rate 1000Hz（解析度 1ms）────────────
CONFIG_FREERTOS_HZ=1000

# ── Log：平常 INFO，上限 DEBUG（可用 esp_log_level_set() 動態調整）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
