# 目標晶片：ESP32-S3 N16R8（16MB Flash、8MB Octal PSRAM）
# ESP-IDF 5.5.3

# ── CPU 頻率：最高 240MHz ─────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Flash：16MB、QIO 模式、80MHz ─────────────────────
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ── PSRAM：8MB Octal 模式、80MHz ─────────────────────
# 啟用 PSRAM，並讓 malloc() 可直接分配 PSRAM
# .bss 靜態變數允許放入外部記憶體以節省內部 SRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ── FreeRTOS：Tick Rate 1000Hz（解析度 1ms）────────────
CONFIG_FREERTOS_HZ=1000

# ── WiFi Buffer ───────────────────────────────────────
# TX 改為動態分配，閒置時不占用以節省 SRAM
# RX 維持官方預設，不為小幅節省引入封包遺失風險
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ── BLE：NimBLE（輕量堆疊，僅用於 BLE Provisioning）────
# 配網完成後需釋放 BLE 資源，注意符合 NimBLE 釋放方式
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# ── Log：平常 INFO，上限 DEBUG（可用 esp_log_level_set() 動態調整）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ── LVGL 字體 ──────────────────────────────────────────
# 預設只有 Montserrat 14，UI 模組額外需要以下尺寸
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_32=y
